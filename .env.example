# Claude
ANTHROPIC_API_KEY=sk-ant-...
SETTER_MODEL=claude-opus-5-5
SETTER_EFFORT=medium

# GoHighLevel sub-account → Settings → Private Integrations
# Scopes: conversations.readonly, conversations.write, conversations/message.readonly,
#         conversations/message.write, contacts.readonly, contacts.write
GHL_API_TOKEN=pit-...
GHL_LOCATION_ID=
# Shared secret. Add ?secret=<this> to the webhook URL in your GHL workflow.
WEBHOOK_SECRET=change-me

# The calendar link sent to qualified leads
BOOKING_LINK=https://

# Safety switches
BOT_ENABLED=true
DRY_RUN=true              # start with true: logs replies instead of sending them
DEBOUNCE_SECONDS=45       # wait for the lead to finish a burst of messages
HUMAN_TAKEOVER_MINUTES=720  # bot stays quiet for 12h after anyone on the team replies manually
