# Claude
ANTHROPIC_API_KEY=sk-ant-...
SETTER_MODEL=claude-opus-5-5
SETTER_EFFORT=medium

# GoHighLevel sub-account → Settings → Private Integrations
# Scopes: conversations.readonly, conversations.write, conversations/message.readonly,
#         conversations/message.write, contacts.readonly, contacts.write
GHL_API_TOKEN=pit-...
GHL_LOCATION_ID=
# Shared secret. Add ?secret=<this> to the webhook URL in your GHL workflow.
WEBHOOK_SECRET=change-me

# The calendar link sent to qualified leads
BOOKING_LINK=https://

# Safety switches
BOT_ENABLED=true
DRY_RUN=true              # start with true: logs replies instead of sending them
DEBOUNCE_SECONDS=45       # wait for the lead to finish a burst of messages
HUMAN_TAKEOVER_MINUTES=720  # bot stays quiet for 12h after anyone on the team replies manually

# ---- HQ: your personal dashboard (uvicorn hq.server:app) ----
HQ_PASSWORD=                # the one password that unlocks HQ
HQ_SECRET_KEY=              # long random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
HQ_TIMEZONE=Australia/Sydney
HQ_CURRENCY=AUD
# Google Calendar → Settings → each calendar → "Secret address in iCal format". Comma separate several.
HQ_CALENDAR_ICS_URLS=
# Stripe → Developers → API keys → Create restricted key, read-only on Balance, Charges, Subscriptions.
STRIPE_API_KEY=rk_live_...
# Asana → profile photo → Settings → Apps → Developer apps → Create new token. HQ's to-dos then live in your
# Asana My Tasks: adding, ticking off and rescheduling in either place shows up in the other.
ASANA_TOKEN=
# ASANA_PROJECT_GID=        # optional: also file new tasks under this project
# HQ_MODEL=claude-opus-5-5
# HQ_EFFORT=medium
# HQ_SECURE_COOKIES=false   # only when running locally over plain http
